      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(consume_skipped[$__rate_interval]))",
          "legendFormat": "skipped - {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum (rate(consume_unhandled_error[$__rate_interval]))",
          "legendFormat": "unhandled",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Delivery outcomes",
      "description": "A produce_error means the S3 object was rolled back and, if configured, a DLQ record was written.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "last",
