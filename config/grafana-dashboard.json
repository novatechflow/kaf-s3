          "calcs": [
            "last",
            "max"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(consume_integrity_error[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Skipped and unhandled",
      "description": "Messages dropped as unusable (tombstone, malformed_message, missing_key) and unexpected consumer errors.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
