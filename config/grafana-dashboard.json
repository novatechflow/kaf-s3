          "legendFormat": "delivery failed",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Producer backpressure",
      "description": "produce_queue_full means librdkafka's local queue stayed full for the whole produce_timeout and the message was rejected. Sustained non-zero means the brokers cannot keep up.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
