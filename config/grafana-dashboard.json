          "refId": "A",
          "expr": "sum by (topic) (rate(produce_offloaded_bytes[$__rate_interval]))",
          "legendFormat": "offloaded - {{topic}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (topic) (rate(produce_inline_bytes[$__rate_interval]))",
          "legendFormat": "inline - {{topic}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Consume rate by path",
