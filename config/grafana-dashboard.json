      "targets": [
        {
          "refId": "A",
          "expr": "sum by (topic) (rate(consume_success_bytes[$__rate_interval]))",
          "legendFormat": "from S3 - {{topic}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (topic) (rate(consume_inline_bytes[$__rate_interval]))",
          "legendFormat": "inline - {{topic}}",
          "datasource": {
